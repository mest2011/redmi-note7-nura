+static int ov13855_write_table(struct ov13855 *ov13855, const struct ov13855_reg *regs,
+			   unsigned int num_regs)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num_regs; i++) {
+		ret = cci_write(ov13855->regmap, OV13855_REGW(regs[i].reg),
+				regs[i].val, NULL);
+		if (ret) {
+			dev_err(ov13855->dev, "write 0x%04x failed: %d\n",
+				regs[i].reg, ret);
+			return ret;
+		}
+
+		if (regs[i].delay_ms)
+			fsleep(regs[i].delay_ms * USEC_PER_MSEC);
+	}
+
+	return 0;
+}
+
+static int ov13855_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov13855 *ov13855 = container_of(ctrl->handler, struct ov13855,
+				       ctrl_handler);
+	const struct ov13855_mode *mode = ov13855->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - OV13855_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(ov13855->exposure,
+					 ov13855->exposure->minimum,
+					 exposure_max,
+					 ov13855->exposure->step,
+					 min_t(s64, ov13855->exposure->default_value,
+					       exposure_max));
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(ov13855->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(ov13855->regmap, OV13855_REG_AGAIN, ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(ov13855->regmap, OV13855_REG_EXPOSURE,
+				ctrl->val << OV13855_EXPOSURE_SHIFT, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(ov13855->regmap, OV13855_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(ov13855->regmap, OV13855_REG_TEST_PATTERN,
+				ctrl->val ? OV13855_TEST_PATTERN_BARS : 0, NULL);
+		break;
+	default:
+		ret = 0;
+		break;
+	}
+
+	pm_runtime_put(ov13855->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov13855_ctrl_ops = {
+	.s_ctrl = ov13855_set_ctrl,
+};
+
+static int ov13855_init_controls(struct ov13855 *ov13855)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &ov13855->ctrl_handler;
+	const struct ov13855_mode *mode = ov13855->mode;
+	s64 hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	ov13855->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &ov13855_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(ov13855_link_freq_menu) - 1,
+					mode->link_freq_index,
+					ov13855_link_freq_menu);
+	if (ov13855->link_freq)
+		ov13855->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov13855->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &ov13855_ctrl_ops,
+					    V4L2_CID_PIXEL_RATE,
+					    mode->pixel_rate, mode->pixel_rate,
+					    1, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	ov13855->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &ov13855_ctrl_ops,
+					V4L2_CID_HBLANK, hblank,
+					hblank, 1, hblank);
+	if (ov13855->hblank)
+		ov13855->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	ov13855->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &ov13855_ctrl_ops,
+					V4L2_CID_VBLANK, vblank,
+					OV13855_VTS_MAX - mode->height, 1,
+					mode->vts_def - mode->height);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &ov13855_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV13855_AGAIN_MIN, OV13855_AGAIN_MAX,
+			  OV13855_AGAIN_STEP, OV13855_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts_def - OV13855_EXPOSURE_MARGIN;
+	ov13855->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &ov13855_ctrl_ops,
+					  V4L2_CID_EXPOSURE,
+					  OV13855_EXPOSURE_MIN,
+					  exposure_max,
+					  OV13855_EXPOSURE_STEP,
+					  mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &ov13855_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov13855_test_pattern_menu) - 1,
+				     0, 0, ov13855_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(ov13855->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &ov13855_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_free_hdlr;
+	}
+
+	ov13855->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int ov13855_enable_streams(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state, u32 pad,
+			      u64 streams_mask)
+{
+	struct ov13855 *ov13855 = to_ov13855(sd);
+	const struct ov13855_mode *mode = ov13855->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov13855->dev);
+	if (ret)
+		return ret;
+
+	ret = ov13855_write_table(ov13855, ov13855_init_regs, ARRAY_SIZE(ov13855_init_regs));
+	if (ret)
+		goto error;
+
+	ret = ov13855_write_table(ov13855, mode->regs, mode->num_regs);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(ov13855->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(ov13855->regmap, OV13855_REG_CTRL_MODE,
+			OV13855_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(ov13855->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(ov13855->dev);
+
+	return ret;
+}
+
+static int ov13855_disable_streams(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state, u32 pad,
+			       u64 streams_mask)
+{
+	struct ov13855 *ov13855 = to_ov13855(sd);
+	int ret;
+
+	ret = cci_write(ov13855->regmap, OV13855_REG_CTRL_MODE, 0x0, NULL);
+	if (ret)
+		dev_err(ov13855->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(ov13855->dev);
+
+	return ret;
+}
+
+static void ov13855_update_pad_format(const struct ov13855_mode *mode,
+				  struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = OV13855_MBUS_CODE;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov13855_set_pad_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct ov13855 *ov13855 = to_ov13855(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct ov13855_mode *mode;
+
+	mode = v4l2_find_nearest_size(ov13855_supported_modes,
+				      ARRAY_SIZE(ov13855_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	ov13855_update_pad_format(mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || ov13855->mode == mode)
+		goto set_format;
+
+	if (v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	/* Update limits and set FPS and exposure to default values */
+	ov13855->mode = mode;
+
+	__v4l2_ctrl_s_ctrl(ov13855->link_freq, mode->link_freq_index);
+	__v4l2_ctrl_modify_range(ov13855->pixel_rate, mode->pixel_rate,
+				 mode->pixel_rate, 1, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(ov13855->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(ov13855->vblank, vblank,
+				 OV13855_VTS_MAX - mode->height, 1,
+				 mode->vts_def - mode->height);
+	__v4l2_ctrl_s_ctrl(ov13855->vblank, mode->vts_def - mode->height);
+
+	exposure_max = mode->vts_def - OV13855_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(ov13855->exposure, OV13855_EXPOSURE_MIN,
+				 exposure_max, OV13855_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(ov13855->exposure, mode->exposure);
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int ov13855_enum_mbus_code(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *sd_state,
+			      struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = OV13855_MBUS_CODE;
+
+	return 0;
+}
+
+static int ov13855_enum_frame_size(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *sd_state,
+			       struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(ov13855_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != OV13855_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = ov13855_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = ov13855_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int ov13855_get_selection(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state,
+			     struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV13855_NATIVE_WIDTH;
+		sel->r.height = OV13855_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int ov13855_init_state(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state)
+{
+	struct ov13855 *ov13855 = to_ov13855(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = ov13855->mode->width,
+			.height = ov13855->mode->height,
+		},
+	};
+
+	ov13855_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov13855_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov13855_pad_ops = {
+	.set_fmt = ov13855_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = ov13855_get_selection,
+	.enum_mbus_code = ov13855_enum_mbus_code,
+	.enum_frame_size = ov13855_enum_frame_size,
+	.enable_streams = ov13855_enable_streams,
+	.disable_streams = ov13855_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov13855_subdev_ops = {
+	.video = &ov13855_video_ops,
+	.pad = &ov13855_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov13855_internal_ops = {
+	.init_state = ov13855_init_state,
+};
+
+static const struct media_entity_operations ov13855_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int ov13855_identify_sensor(struct ov13855 *ov13855)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(ov13855->regmap, OV13855_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(ov13855->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != OV13855_CHIP_ID) {
+		dev_err(ov13855->dev, "chip id mismatch: %x!=%llx\n",
+			OV13855_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	dev_info(ov13855->dev, "chip id 0x%llx\n", val);
+
+	return 0;
+}
+
+static int ov13855_check_hwcfg(struct ov13855 *ov13855)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(ov13855->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != OV13855_DATA_LANES) {
+		dev_err(ov13855->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+	}
+
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int ov13855_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13855 *ov13855 = to_ov13855(sd);
+	int ret;
+
+	gpiod_set_value_cansleep(ov13855->reset_gpio, 1);
+	gpiod_set_value_cansleep(ov13855->powerdown_gpio, 1);
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = regulator_bulk_enable(OV13855_NUM_SUPPLIES, ov13855->supplies);
+	if (ret)
+		return ret;
+
+	if (ov13855->afvdd) {
+		ret = regulator_enable(ov13855->afvdd);
+		if (ret)
+			goto disable_supplies;
+	}
+
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(ov13855->mclk);
+	if (ret)
+		goto disable_afvdd;
+
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	gpiod_set_value_cansleep(ov13855->reset_gpio, 0);
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+	gpiod_set_value_cansleep(ov13855->powerdown_gpio, 0);
+	usleep_range(12 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_afvdd:
+	if (ov13855->afvdd)
+		regulator_disable(ov13855->afvdd);
+
+disable_supplies:
+	regulator_bulk_disable(OV13855_NUM_SUPPLIES, ov13855->supplies);
+
+	return ret;
+}
+
+static int ov13855_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13855 *ov13855 = to_ov13855(sd);
+
+	gpiod_set_value_cansleep(ov13855->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(ov13855->reset_gpio, 1);
+
+	clk_disable_unprepare(ov13855->mclk);
+
+	if (ov13855->afvdd)
+		regulator_disable(ov13855->afvdd);
+
+	regulator_bulk_disable(OV13855_NUM_SUPPLIES, ov13855->supplies);
+
+	return 0;
+}
+
+static int ov13855_probe(struct i2c_client *client)
+{
+	struct ov13855 *ov13855;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	ov13855 = devm_kzalloc(&client->dev, sizeof(*ov13855), GFP_KERNEL);
+	if (!ov13855)
+		return -ENOMEM;
+
+	ov13855->dev = &client->dev;
+	v4l2_i2c_subdev_init(&ov13855->sd, client, &ov13855_subdev_ops);
+
+	ov13855->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov13855->regmap))
+		return dev_err_probe(ov13855->dev, PTR_ERR(ov13855->regmap),
+				     "failed to init CCI\n");
+
+	ov13855->mclk = devm_v4l2_sensor_clk_get(ov13855->dev, NULL);
+	if (IS_ERR(ov13855->mclk))
+		return dev_err_probe(ov13855->dev, PTR_ERR(ov13855->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(ov13855->mclk);
+	if (freq != OV13855_MCLK_FREQ_24MHZ)
+		return dev_err_probe(ov13855->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = ov13855_check_hwcfg(ov13855);
+	if (ret)
+		return dev_err_probe(ov13855->dev, ret,
+				     "failed to check HW configuration\n");
+
+	ov13855->reset_gpio = devm_gpiod_get_optional(ov13855->dev, "reset",
+						  GPIOD_OUT_HIGH);
+	if (IS_ERR(ov13855->reset_gpio))
+		return dev_err_probe(ov13855->dev, PTR_ERR(ov13855->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	ov13855->powerdown_gpio = devm_gpiod_get_optional(ov13855->dev, "powerdown",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(ov13855->powerdown_gpio))
+		return dev_err_probe(ov13855->dev, PTR_ERR(ov13855->powerdown_gpio),
+				     "cannot get powerdown GPIO\n");
+
+	for (i = 0; i < OV13855_NUM_SUPPLIES; i++)
+		ov13855->supplies[i].supply = ov13855_supply_names[i];
+
+	ret = devm_regulator_bulk_get(ov13855->dev, OV13855_NUM_SUPPLIES,
+				      ov13855->supplies);
+	if (ret)
+		return dev_err_probe(ov13855->dev, ret,
+				     "failed to get regulators\n");
+
+	ov13855->afvdd = devm_regulator_get_optional(ov13855->dev, "afvdd");
+	if (IS_ERR(ov13855->afvdd)) {
+		ret = PTR_ERR(ov13855->afvdd);
+		if (ret != -ENODEV)
+			return dev_err_probe(ov13855->dev, ret,
+					     "failed to get 'afvdd' regulator\n");
+
+		ov13855->afvdd = NULL;
+	}
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = ov13855_power_on(ov13855->dev);
+	if (ret)
+		return dev_err_probe(ov13855->dev, ret, "failed to power on\n");
+
+	ret = ov13855_identify_sensor(ov13855);
+	if (ret) {
+		dev_err_probe(ov13855->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	ov13855->mode = &ov13855_supported_modes[0];
+	ret = ov13855_init_controls(ov13855);
+	if (ret) {
+		dev_err_probe(ov13855->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	ov13855->sd.state_lock = ov13855->ctrl_handler.lock;
+	ov13855->sd.internal_ops = &ov13855_internal_ops;
+	ov13855->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov13855->sd.entity.ops = &ov13855_subdev_entity_ops;
+	ov13855->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov13855->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&ov13855->sd.entity, 1, &ov13855->pad);
+	if (ret) {
+		dev_err_probe(ov13855->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&ov13855->sd);
+	if (ret < 0) {
+		dev_err_probe(ov13855->dev, ret, "failed to init subdev\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(ov13855->dev);
+	pm_runtime_enable(ov13855->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov13855->sd);
+	if (ret < 0) {
+		dev_err_probe(ov13855->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(ov13855->dev, 1000);
+	pm_runtime_use_autosuspend(ov13855->dev);
+	pm_runtime_idle(ov13855->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&ov13855->sd);
+	pm_runtime_disable(ov13855->dev);
+	pm_runtime_set_suspended(ov13855->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&ov13855->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(ov13855->sd.ctrl_handler);
+
+power_off:
+	ov13855_power_off(ov13855->dev);
+
+	return ret;
+}
+
+static void ov13855_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov13855 *ov13855 = to_ov13855(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(ov13855->dev);
+
+	if (!pm_runtime_status_suspended(ov13855->dev)) {
+		ov13855_power_off(ov13855->dev);
+		pm_runtime_set_suspended(ov13855->dev);
+	}
+}
+
+static const struct dev_pm_ops ov13855_pm_ops = {
+	SET_RUNTIME_PM_OPS(ov13855_power_off, ov13855_power_on, NULL)
+};
+
+static const struct of_device_id ov13855_of_match[] = {
+	{ .compatible = "ovti,ov13855" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov13855_of_match);
+
+static struct i2c_driver ov13855_i2c_driver = {
+	.driver = {
+		.name = "ov13855",
+		.pm = &ov13855_pm_ops,
+		.of_match_table = ov13855_of_match,
+	},
+	.probe = ov13855_probe,
+	.remove = ov13855_remove,
+};
+
+module_i2c_driver(ov13855_i2c_driver);
+
+MODULE_DESCRIPTION("OmniVision OV13855 image sensor driver");
+MODULE_LICENSE("GPL");
