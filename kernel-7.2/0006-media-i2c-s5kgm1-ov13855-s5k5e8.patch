+static int s5kgm1_write_table(struct s5kgm1 *s5kgm1, const struct s5kgm1_reg *regs,
+			   unsigned int num_regs)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num_regs; i++) {
+		ret = cci_write(s5kgm1->regmap, S5KGM1_REGW(regs[i].reg),
+				regs[i].val, NULL);
+		if (ret) {
+			dev_err(s5kgm1->dev, "write 0x%04x failed: %d\n",
+				regs[i].reg, ret);
+			return ret;
+		}
+
+		if (regs[i].delay_ms)
+			fsleep(regs[i].delay_ms * USEC_PER_MSEC);
+	}
+
+	return 0;
+}
+
+static int s5kgm1_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5kgm1 *s5kgm1 = container_of(ctrl->handler, struct s5kgm1,
+				       ctrl_handler);
+	const struct s5kgm1_mode *mode = s5kgm1->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - S5KGM1_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5kgm1->exposure,
+					 s5kgm1->exposure->minimum,
+					 exposure_max,
+					 s5kgm1->exposure->step,
+					 min_t(s64, s5kgm1->exposure->default_value,
+					       exposure_max));
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5kgm1->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5kgm1->regmap, S5KGM1_REG_AGAIN, ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5kgm1->regmap, S5KGM1_REG_EXPOSURE,
+				ctrl->val << S5KGM1_EXPOSURE_SHIFT, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5kgm1->regmap, S5KGM1_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5kgm1->regmap, S5KGM1_REG_TEST_PATTERN,
+				ctrl->val ? S5KGM1_TEST_PATTERN_BARS : 0, NULL);
+		break;
+	default:
+		ret = 0;
+		break;
+	}
+
+	pm_runtime_put(s5kgm1->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5kgm1_ctrl_ops = {
+	.s_ctrl = s5kgm1_set_ctrl,
+};
+
+static int s5kgm1_init_controls(struct s5kgm1 *s5kgm1)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5kgm1->ctrl_handler;
+	const struct s5kgm1_mode *mode = s5kgm1->mode;
+	s64 hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	s5kgm1->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5kgm1_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5kgm1_link_freq_menu) - 1,
+					mode->link_freq_index,
+					s5kgm1_link_freq_menu);
+	if (s5kgm1->link_freq)
+		s5kgm1->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5kgm1->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5kgm1_ctrl_ops,
+					    V4L2_CID_PIXEL_RATE,
+					    mode->pixel_rate, mode->pixel_rate,
+					    1, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5kgm1->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5kgm1_ctrl_ops,
+					V4L2_CID_HBLANK, hblank,
+					hblank, 1, hblank);
+	if (s5kgm1->hblank)
+		s5kgm1->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5kgm1->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5kgm1_ctrl_ops,
+					V4L2_CID_VBLANK, vblank,
+					S5KGM1_VTS_MAX - mode->height, 1,
+					mode->vts_def - mode->height);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5kgm1_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5KGM1_AGAIN_MIN, S5KGM1_AGAIN_MAX,
+			  S5KGM1_AGAIN_STEP, S5KGM1_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts_def - S5KGM1_EXPOSURE_MARGIN;
+	s5kgm1->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5kgm1_ctrl_ops,
+					  V4L2_CID_EXPOSURE,
+					  S5KGM1_EXPOSURE_MIN,
+					  exposure_max,
+					  S5KGM1_EXPOSURE_STEP,
+					  mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5kgm1_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5kgm1_test_pattern_menu) - 1,
+				     0, 0, s5kgm1_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(s5kgm1->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5kgm1_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_free_hdlr;
+	}
+
+	s5kgm1->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5kgm1_enable_streams(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state, u32 pad,
+			      u64 streams_mask)
+{
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+	const struct s5kgm1_mode *mode = s5kgm1->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5kgm1->dev);
+	if (ret)
+		return ret;
+
+	ret = s5kgm1_write_table(s5kgm1, s5kgm1_init_regs, ARRAY_SIZE(s5kgm1_init_regs));
+	if (ret)
+		goto error;
+
+	ret = s5kgm1_write_table(s5kgm1, mode->regs, mode->num_regs);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5kgm1->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(s5kgm1->regmap, S5KGM1_REG_CTRL_MODE,
+			S5KGM1_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(s5kgm1->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5kgm1->dev);
+
+	return ret;
+}
+
+static int s5kgm1_disable_streams(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state, u32 pad,
+			       u64 streams_mask)
+{
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+	int ret;
+
+	ret = cci_write(s5kgm1->regmap, S5KGM1_REG_CTRL_MODE, 0x0, NULL);
+	if (ret)
+		dev_err(s5kgm1->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5kgm1->dev);
+
+	return ret;
+}
+
+static void s5kgm1_update_pad_format(const struct s5kgm1_mode *mode,
+				  struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = S5KGM1_MBUS_CODE;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5kgm1_set_pad_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5kgm1_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5kgm1_supported_modes,
+				      ARRAY_SIZE(s5kgm1_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5kgm1_update_pad_format(mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5kgm1->mode == mode)
+		goto set_format;
+
+	if (v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	/* Update limits and set FPS and exposure to default values */
+	s5kgm1->mode = mode;
+
+	__v4l2_ctrl_s_ctrl(s5kgm1->link_freq, mode->link_freq_index);
+	__v4l2_ctrl_modify_range(s5kgm1->pixel_rate, mode->pixel_rate,
+				 mode->pixel_rate, 1, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5kgm1->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5kgm1->vblank, vblank,
+				 S5KGM1_VTS_MAX - mode->height, 1,
+				 mode->vts_def - mode->height);
+	__v4l2_ctrl_s_ctrl(s5kgm1->vblank, mode->vts_def - mode->height);
+
+	exposure_max = mode->vts_def - S5KGM1_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5kgm1->exposure, S5KGM1_EXPOSURE_MIN,
+				 exposure_max, S5KGM1_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5kgm1->exposure, mode->exposure);
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5kgm1_enum_mbus_code(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *sd_state,
+			      struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = S5KGM1_MBUS_CODE;
+
+	return 0;
+}
+
+static int s5kgm1_enum_frame_size(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *sd_state,
+			       struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(s5kgm1_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != S5KGM1_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = s5kgm1_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5kgm1_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5kgm1_get_selection(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state,
+			     struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5KGM1_NATIVE_WIDTH;
+		sel->r.height = S5KGM1_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5kgm1_init_state(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state)
+{
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5kgm1->mode->width,
+			.height = s5kgm1->mode->height,
+		},
+	};
+
+	s5kgm1_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5kgm1_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5kgm1_pad_ops = {
+	.set_fmt = s5kgm1_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5kgm1_get_selection,
+	.enum_mbus_code = s5kgm1_enum_mbus_code,
+	.enum_frame_size = s5kgm1_enum_frame_size,
+	.enable_streams = s5kgm1_enable_streams,
+	.disable_streams = s5kgm1_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5kgm1_subdev_ops = {
+	.video = &s5kgm1_video_ops,
+	.pad = &s5kgm1_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5kgm1_internal_ops = {
+	.init_state = s5kgm1_init_state,
+};
+
+static const struct media_entity_operations s5kgm1_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5kgm1_identify_sensor(struct s5kgm1 *s5kgm1)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s5kgm1->regmap, S5KGM1_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5kgm1->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != S5KGM1_CHIP_ID) {
+		dev_err(s5kgm1->dev, "chip id mismatch: %x!=%llx\n",
+			S5KGM1_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	dev_info(s5kgm1->dev, "chip id 0x%llx\n", val);
+
+	return 0;
+}
+
+static int s5kgm1_check_hwcfg(struct s5kgm1 *s5kgm1)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5kgm1->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5KGM1_DATA_LANES) {
+		dev_err(s5kgm1->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+	}
+
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5kgm1_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+	int ret;
+
+	gpiod_set_value_cansleep(s5kgm1->reset_gpio, 1);
+	gpiod_set_value_cansleep(s5kgm1->powerdown_gpio, 1);
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = regulator_bulk_enable(S5KGM1_NUM_SUPPLIES, s5kgm1->supplies);
+	if (ret)
+		return ret;
+
+	if (s5kgm1->afvdd) {
+		ret = regulator_enable(s5kgm1->afvdd);
+		if (ret)
+			goto disable_supplies;
+	}
+
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(s5kgm1->mclk);
+	if (ret)
+		goto disable_afvdd;
+
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	gpiod_set_value_cansleep(s5kgm1->reset_gpio, 0);
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+	gpiod_set_value_cansleep(s5kgm1->powerdown_gpio, 0);
+	usleep_range(12 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_afvdd:
+	if (s5kgm1->afvdd)
+		regulator_disable(s5kgm1->afvdd);
+
+disable_supplies:
+	regulator_bulk_disable(S5KGM1_NUM_SUPPLIES, s5kgm1->supplies);
+
+	return ret;
+}
+
+static int s5kgm1_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+
+	gpiod_set_value_cansleep(s5kgm1->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(s5kgm1->reset_gpio, 1);
+
+	clk_disable_unprepare(s5kgm1->mclk);
+
+	if (s5kgm1->afvdd)
+		regulator_disable(s5kgm1->afvdd);
+
+	regulator_bulk_disable(S5KGM1_NUM_SUPPLIES, s5kgm1->supplies);
+
+	return 0;
+}
+
+static int s5kgm1_probe(struct i2c_client *client)
+{
+	struct s5kgm1 *s5kgm1;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5kgm1 = devm_kzalloc(&client->dev, sizeof(*s5kgm1), GFP_KERNEL);
+	if (!s5kgm1)
+		return -ENOMEM;
+
+	s5kgm1->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5kgm1->sd, client, &s5kgm1_subdev_ops);
+
+	s5kgm1->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5kgm1->regmap))
+		return dev_err_probe(s5kgm1->dev, PTR_ERR(s5kgm1->regmap),
+				     "failed to init CCI\n");
+
+	s5kgm1->mclk = devm_v4l2_sensor_clk_get(s5kgm1->dev, NULL);
+	if (IS_ERR(s5kgm1->mclk))
+		return dev_err_probe(s5kgm1->dev, PTR_ERR(s5kgm1->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(s5kgm1->mclk);
+	if (freq != S5KGM1_MCLK_FREQ_24MHZ)
+		return dev_err_probe(s5kgm1->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5kgm1_check_hwcfg(s5kgm1);
+	if (ret)
+		return dev_err_probe(s5kgm1->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5kgm1->reset_gpio = devm_gpiod_get_optional(s5kgm1->dev, "reset",
+						  GPIOD_OUT_HIGH);
+	if (IS_ERR(s5kgm1->reset_gpio))
+		return dev_err_probe(s5kgm1->dev, PTR_ERR(s5kgm1->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	s5kgm1->powerdown_gpio = devm_gpiod_get_optional(s5kgm1->dev, "powerdown",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(s5kgm1->powerdown_gpio))
+		return dev_err_probe(s5kgm1->dev, PTR_ERR(s5kgm1->powerdown_gpio),
+				     "cannot get powerdown GPIO\n");
+
+	for (i = 0; i < S5KGM1_NUM_SUPPLIES; i++)
+		s5kgm1->supplies[i].supply = s5kgm1_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5kgm1->dev, S5KGM1_NUM_SUPPLIES,
+				      s5kgm1->supplies);
+	if (ret)
+		return dev_err_probe(s5kgm1->dev, ret,
+				     "failed to get regulators\n");
+
+	s5kgm1->afvdd = devm_regulator_get_optional(s5kgm1->dev, "afvdd");
+	if (IS_ERR(s5kgm1->afvdd)) {
+		ret = PTR_ERR(s5kgm1->afvdd);
+		if (ret != -ENODEV)
+			return dev_err_probe(s5kgm1->dev, ret,
+					     "failed to get 'afvdd' regulator\n");
+
+		s5kgm1->afvdd = NULL;
+	}
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5kgm1_power_on(s5kgm1->dev);
+	if (ret)
+		return dev_err_probe(s5kgm1->dev, ret, "failed to power on\n");
+
+	ret = s5kgm1_identify_sensor(s5kgm1);
+	if (ret) {
+		dev_err_probe(s5kgm1->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5kgm1->mode = &s5kgm1_supported_modes[0];
+	ret = s5kgm1_init_controls(s5kgm1);
+	if (ret) {
+		dev_err_probe(s5kgm1->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5kgm1->sd.state_lock = s5kgm1->ctrl_handler.lock;
+	s5kgm1->sd.internal_ops = &s5kgm1_internal_ops;
+	s5kgm1->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5kgm1->sd.entity.ops = &s5kgm1_subdev_entity_ops;
+	s5kgm1->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5kgm1->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5kgm1->sd.entity, 1, &s5kgm1->pad);
+	if (ret) {
+		dev_err_probe(s5kgm1->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5kgm1->sd);
+	if (ret < 0) {
+		dev_err_probe(s5kgm1->dev, ret, "failed to init subdev\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5kgm1->dev);
+	pm_runtime_enable(s5kgm1->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5kgm1->sd);
+	if (ret < 0) {
+		dev_err_probe(s5kgm1->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5kgm1->dev, 1000);
+	pm_runtime_use_autosuspend(s5kgm1->dev);
+	pm_runtime_idle(s5kgm1->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5kgm1->sd);
+	pm_runtime_disable(s5kgm1->dev);
+	pm_runtime_set_suspended(s5kgm1->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5kgm1->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5kgm1->sd.ctrl_handler);
+
+power_off:
+	s5kgm1_power_off(s5kgm1->dev);
+
+	return ret;
+}
+
+static void s5kgm1_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5kgm1 *s5kgm1 = to_s5kgm1(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5kgm1->dev);
+
+	if (!pm_runtime_status_suspended(s5kgm1->dev)) {
+		s5kgm1_power_off(s5kgm1->dev);
+		pm_runtime_set_suspended(s5kgm1->dev);
+	}
+}
+
+static const struct dev_pm_ops s5kgm1_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5kgm1_power_off, s5kgm1_power_on, NULL)
+};
+
+static const struct of_device_id s5kgm1_of_match[] = {
+	{ .compatible = "samsung,s5kgm1" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5kgm1_of_match);
+
+static struct i2c_driver s5kgm1_i2c_driver = {
+	.driver = {
+		.name = "s5kgm1",
+		.pm = &s5kgm1_pm_ops,
+		.of_match_table = s5kgm1_of_match,
+	},
+	.probe = s5kgm1_probe,
+	.remove = s5kgm1_remove,
+};
+
+module_i2c_driver(s5kgm1_i2c_driver);
